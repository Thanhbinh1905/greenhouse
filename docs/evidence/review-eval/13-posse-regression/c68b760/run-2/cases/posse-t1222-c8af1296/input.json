79: // Qualifies reports whether this verdict meets the exact-head gate rule.
80: func (verdict Verdict) Qualifies(head string) bool {
81: 	return verdict.Mode == "gate" && verdict.Head == head &&
82: 		(verdict.Outcome == "clean" || verdict.Outcome == "findings" && verdict.Blocking == 0)
83: }

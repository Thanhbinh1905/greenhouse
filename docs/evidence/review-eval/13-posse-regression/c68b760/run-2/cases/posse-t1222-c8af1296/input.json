46: // VerdictsFor returns the immutable provider results recorded for a Task.
47: func (db *DB) VerdictsFor(ctx context.Context, taskID int64) ([]Verdict, error) {
48: 	rows, err := db.QueryContext(ctx, `SELECT task_id,repo,provider,protocol,COALESCE(grant_id,''),head_sha,target_sha,review_base_sha,verdict,blocking,rules_digest,config_digest,input_digest,backend,model,findings_digest,findings_path,mode,recorded_at FROM verdicts WHERE task_id=? ORDER BY recorded_at,id`, taskID)
49: 	if err != nil {
50: 		return nil, err
51: 	}
52: 	defer rows.Close()
53: 	var verdicts []Verdict
54: 	for rows.Next() {
55: 		var verdict Verdict
56: 		if err := rows.Scan(&verdict.TaskID, &verdict.Repository, &verdict.Provider, &verdict.Protocol, &verdict.Grant, &verdict.Head, &verdict.Target, &verdict.ReviewBase, &verdict.Outcome, &verdict.Blocking, &verdict.RulesDigest, &verdict.ConfigDigest, &verdict.InputDigest, &verdict.Backend, &verdict.Model, &verdict.FindingsHash, &verdict.FindingsPath, &verdict.Mode, &verdict.RecordedAt); err != nil {
57: 			return nil, err
58: 		}
59: 		verdicts = append(verdicts, verdict)
60: 	}
61: 	return verdicts, rows.Err()
62: }

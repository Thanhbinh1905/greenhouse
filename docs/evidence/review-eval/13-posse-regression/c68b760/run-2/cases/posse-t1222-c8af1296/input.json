187: func recordBuiltinVerdictsTx(ctx context.Context, tx *writeTx, taskID int64, input ReviewVerdictInput) error {
188: 	provider := ReviewProvider(builtinReviewProvider{})
189: 	outcome := "clean"
190: 	blocking := 0
191: 	switch input.Verdict {
192: 	case ReviewChangesRequested:
193: 		outcome = "findings"
194: 	case ReviewInconclusive:
195: 		outcome = "inconclusive"
196: 	}
197: 	rows, err := tx.QueryContext(ctx, `SELECT ship_task_id,repository,head_sha,target_commit_sha,scope_base_sha FROM review_rounds WHERE review_task_id=? ORDER BY repository`, taskID)
198: 	if err != nil {
199: 		return err
200: 	}
201: 	var verdicts []Verdict
202: 	for rows.Next() {
203: 		var verdict Verdict
204: 		var changeTaskID int64
205: 		verdict.TaskID, verdict.Provider, verdict.Protocol, verdict.Mode = taskID, BuiltinReviewProvider, "builtin-v1", "gate"
206: 		verdict.Outcome, verdict.Blocking = outcome, blocking
207: 		if err := rows.Scan(&changeTaskID, &verdict.Repository, &verdict.Head, &verdict.Target, &verdict.ReviewBase); err != nil {
208: 			rows.Close()
209: 			return err
210: 		}
211: 		if outcome == "findings" {
212: 			verdict.Blocking, err = countBlockingReviewFindingsTx(ctx, tx, changeTaskID, verdict.Repository, input.Findings.BlockAt)
213: 			if err != nil {
214: 				rows.Close()
215: 				return err
216: 			}
217: 		}
218: 		verdicts = append(verdicts, verdict)
219: 	}
220: 	if err := rows.Err(); err != nil {
221: 		rows.Close()
222: 		return err
223: 	}
224: 	rows.Close()
225: 	if len(verdicts) == 0 {
226: 		targets, err := queryReviewTargets(ctx, tx, taskID)
227: 		if err != nil {
228: 			return err
229: 		}
230: 		for _, target := range targets {
231: 			verdicts = append(verdicts, Verdict{TaskID: taskID, Repository: target.Repository, Provider: BuiltinReviewProvider, Protocol: "builtin-v1", Head: target.Commit, Target: target.Commit, ReviewBase: target.Commit, Outcome: outcome, Blocking: blocking, Mode: "gate"})
232: 		}
233: 	}
234: 	for _, verdict := range verdicts {
235: 		if err := provider.RecordVerdict(ctx, tx, verdict); err != nil {
236: 			return err
237: 		}
238: 	}
239: 	return nil
240: }

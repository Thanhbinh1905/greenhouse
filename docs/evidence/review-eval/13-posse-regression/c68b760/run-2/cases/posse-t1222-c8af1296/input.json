64: func (builtinReviewProvider) RecordVerdict(ctx context.Context, tx VerdictTx, verdict Verdict) error {
65: 	if verdict.Provider != BuiltinReviewProvider {
66: 		return sql.ErrNoRows
67: 	}
68: 	if verdict.RecordedAt == 0 {
69: 		verdict.RecordedAt = time.Now().UnixMilli()
70: 	}
71: 	_, err := tx.ExecContext(ctx, `INSERT INTO verdicts(task_id,repo,provider,protocol,grant_id,head_sha,target_sha,review_base_sha,verdict,blocking,rules_digest,config_digest,input_digest,backend,model,findings_digest,findings_path,mode,recorded_at) VALUES(?,?,?,?,NULLIF(?,''),?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,
72: 		verdict.TaskID, verdict.Repository, verdict.Provider, verdict.Protocol, verdict.Grant,
73: 		verdict.Head, verdict.Target, verdict.ReviewBase, verdict.Outcome, verdict.Blocking,
74: 		verdict.RulesDigest, verdict.ConfigDigest, verdict.InputDigest, verdict.Backend, verdict.Model,
75: 		verdict.FindingsHash, verdict.FindingsPath, verdict.Mode, verdict.RecordedAt)
76: 	return err
77: }

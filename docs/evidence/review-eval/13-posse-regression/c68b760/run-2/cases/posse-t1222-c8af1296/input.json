169: // CurrentReviewPass returns the newest pass verdict of the Change Task whose
170: // bound targets equal its current candidate commits. A candidate that has
171: // moved has no current pass, and an older pass is never rebound to the new
172: // commits because targets are fixed when the Review Task is admitted.
173: func (db *DB) CurrentReviewPass(ctx context.Context, changeTaskID int64, candidate []ReviewTarget) (ReviewVerdict, bool, error) {
174: 	verdicts, err := db.ReviewVerdictsFor(ctx, changeTaskID)
175: 	if err != nil {
176: 		return ReviewVerdict{}, false, err
177: 	}
178: 	for _, verdict := range verdicts {
179: 		if verdict.Verdict != ReviewPass || !SameReviewTargets(verdict.Targets, candidate) {
180: 			continue
181: 		}
182: 		return verdict, true, nil
183: 	}
184: 	return ReviewVerdict{}, false, nil
185: }

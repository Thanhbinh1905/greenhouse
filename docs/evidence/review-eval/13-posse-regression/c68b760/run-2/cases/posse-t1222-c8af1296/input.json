34: // VerdictTx is the transaction boundary used when a provider records its result.
35: type VerdictTx interface {
36: 	ExecContext(context.Context, string, ...any) (sql.Result, error)
37: }
38: 
39: // ReviewProvider persists a provider's result within the review completion transaction.
40: type ReviewProvider interface {
41: 	RecordVerdict(context.Context, VerdictTx, Verdict) error
42: }

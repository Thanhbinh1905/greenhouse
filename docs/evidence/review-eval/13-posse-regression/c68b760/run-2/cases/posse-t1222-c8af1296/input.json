85: func countBlockingReviewFindingsTx(ctx context.Context, tx *writeTx, taskID int64, repository, blockAt string) (int, error) {
86: 	threshold := map[string]int{"P0": 0, "P1": 1, "P2": 2}[blockAt]
87: 	rows, err := tx.QueryContext(ctx, `SELECT severity FROM review_findings WHERE ship_task_id=? AND repository=? AND origin='introduced' AND in_scope=1 AND state IN ('open','fix_claimed','unverified','disputed','regressed')`, taskID, repository)
88: 	if err != nil {
89: 		return 0, err
90: 	}
91: 	defer rows.Close()
92: 	blocking := 0
93: 	for rows.Next() {
94: 		var severity string
95: 		if err := rows.Scan(&severity); err != nil {
96: 			return 0, err
97: 		}
98: 		rank, known := map[string]int{"P0": 0, "P1": 1, "P2": 2, "P3": 3}[severity]
99: 		if !known || rank <= threshold {
100: 			blocking++
101: 		}
102: 	}
103: 	return blocking, rows.Err()
104: }

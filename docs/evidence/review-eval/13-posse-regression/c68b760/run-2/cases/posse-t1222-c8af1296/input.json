11: // Verdict is an immutable review result bound to one repository head and target.
12: type Verdict struct {
13: 	TaskID       int64
14: 	Repository   string
15: 	Provider     string
16: 	Protocol     string
17: 	Grant        string
18: 	Head         string
19: 	Target       string
20: 	ReviewBase   string
21: 	Outcome      string
22: 	Blocking     int
23: 	RulesDigest  string
24: 	ConfigDigest string
25: 	InputDigest  string
26: 	Backend      string
27: 	Model        string
28: 	FindingsHash string
29: 	FindingsPath string
30: 	Mode         string
31: 	RecordedAt   int64
32: }

111: 		if !workspaceFound {
112: 			t.Fatalf("Workspace Worker is not anchored at its Sandbox root: %#v", snapshot.Workspaces)
113: 		}
114: 	}
115: 	assertOrder()
116: 	originalWorkspaceID := task.HerdrWorkspaceID
117: 	secondBrief := filepath.Join(f.root, "workspace-worker-second.md")
118: 	if err := os.WriteFile(secondBrief, []byte("---\ntype: change\ntitle: Workspace worker second\ndone_when: workspace workers stay grouped\nrepos: [backend]\n---\nWait.\n"), 0o600); err != nil {
119: 		t.Fatal(err)
120: 	}
121: 	output = runPosse(t, f.binary, workspaceRoot, leadEnv, "start", "--brief", secondBrief, "--name", "workspace-worker-second")
122: 	var secondTask store.Task
123: 	if !waitForCondition(20*time.Second, func() bool {
124: 		db, err := store.OpenReadOnly(f.home)
125: 		if err != nil {
126: 			return false
127: 		}
128: 		defer db.Close()
129: 		secondTask, err = db.Task(context.Background(), workspaceProject.ID, "t2")
130: 		return err == nil && secondTask.State == store.StateWorking
131: 	}) {
132: 		t.Fatalf("second Workspace Project Worker did not start: %s", output)
133: 	}
134: 	assertGroupedOrder := func() {
135: 		t.Helper()
136: 		snapshot := f.snapshot(t)
137: 		ids := make([]string, len(snapshot.Workspaces))
138: 		for i, workspace := range snapshot.Workspaces {
139: 			ids[i] = workspace.WorkspaceID
140: 			if workspace.WorkspaceID == task.HerdrWorkspaceID && workspace.Label != "└ workspace-worker-t1" {
141: 				t.Fatalf("first Workspace Worker label = %q", workspace.Label)
142: 			}
143: 			if workspace.WorkspaceID == secondTask.HerdrWorkspaceID && workspace.Label != "└ workspace-worker-second-t2" {
144: 				t.Fatalf("second Workspace Worker label = %q", workspace.Label)
145: 			}
146: 		}
147: 		leadIndex := -1
148: 		for i, id := range ids {
149: 			if id == lead.Workspace.WorkspaceID {
150: 				leadIndex = i
151: 				break
152: 			}
153: 		}
154: 		if leadIndex < 0 || leadIndex+2 >= len(ids) || ids[leadIndex+1] != task.HerdrWorkspaceID || ids[leadIndex+2] != secondTask.HerdrWorkspaceID {
155: 			t.Fatalf("Workspace Project sidebar order = %v, want Lead %s followed by %s, %s", ids, lead.Workspace.WorkspaceID, task.HerdrWorkspaceID, secondTask.HerdrWorkspaceID)
156: 		}
157: 	}
158: 	assertGroupedOrder()
159: 	db, err = store.Open(f.home)
160: 	if err != nil {
161: 		t.Fatal(err)
162: 	}
163: 	if err := db.Transition(context.Background(), task.ID, store.StateWorking, store.StateFailed, "worker", "relaunch test"); err != nil {
164: 		_ = db.Close()
165: 		t.Fatal(err)
166: 	}
167: 	if err := db.Close(); err != nil {
168: 		t.Fatal(err)
169: 	}
170: 	if err := os.WriteFile(filepath.Join(task.WorktreePath, ".posse-e2e-agent-exit"), nil, 0o600); err != nil {
171: 		t.Fatal(err)
172: 	}
173: 	runPosse(t, f.binary, workspaceRoot, leadEnv, "relaunch", "t1")
174: 	if !waitForCondition(20*time.Second, func() bool {
175: 		db, err := store.OpenReadOnly(f.home)
176: 		if err != nil {
177: 			return false
178: 		}
179: 		defer db.Close()
180: 		current, err := db.Task(context.Background(), workspaceProject.ID, "t1")
181: 		if err != nil || current.State != store.StateWorking {
182: 			return false
183: 		}
184: 		task = current
185: 		return task.HerdrWorkspaceID == originalWorkspaceID
186: 	}) {
187: 		t.Fatalf("Workspace Worker relaunch did not reuse sub-workspace %s", originalWorkspaceID)
188: 	}
189: 	assertOrder()
190: 	assertGroupedOrder()
191: 	killServer(t, f.server)
192: 	f.server = startServer(t, f.client)
193: 	runPosse(t, f.binary, workspaceRoot, f.env, "up", "--all")
194: 	if !waitForCondition(30*time.Second, func() bool {
195: 		db, err := store.OpenReadOnly(f.home)
196: 		if err != nil {
197: 			return false
198: 		}
199: 		defer db.Close()
200: 		task, err = db.Task(context.Background(), workspaceProject.ID, "t1")
201: 		if err != nil || task.State != store.StateWorking {
202: 			return false
203: 		}
204: 		secondTask, err = db.Task(context.Background(), workspaceProject.ID, "t2")
205: 		return err == nil && secondTask.State == store.StateWorking
206: 	}) {
207: 		t.Fatalf("Workspace Project Workers did not restore after Herdr restart: t1=%#v t2=%#v", task, secondTask)
208: 	}
209: 	projectDB, err := store.OpenReadOnly(f.home)
210: 	if err != nil {
211: 		t.Fatal(err)
212: 	}
213: 	workspaceProject, err = projectDB.ProjectByID(context.Background(), workspaceProject.ID)
214: 	if closeErr := projectDB.Close(); err == nil {
215: 		err = closeErr
216: 	}
217: 	if err != nil {
218: 		t.Fatal(err)
219: 	}
220: 	lead.Workspace.WorkspaceID = workspaceProject.HerdrWorkspaceID
221: 	lead.RootPane.PaneID = workspaceProject.LeadPaneID
222: 	leadEnv = setEnv(leadEnv, "HERDR_PANE_ID", workspaceProject.LeadPaneID)
223: 	leadEnv = setEnv(leadEnv, "HERDR_WORKSPACE_ID", workspaceProject.HerdrWorkspaceID)
224: 	assertGroupedOrder()
225: 	runPosse(t, f.binary, workspaceRoot, leadEnv, "teardown", "t1", "--discard", "--user-approved", "User approved the Workspace Project child teardown test")
226: 	for _, workspace := range f.snapshot(t).Workspaces {
227: 		if workspace.WorkspaceID == originalWorkspaceID {
228: 			t.Fatalf("Workspace Project teardown left sub-workspace open: %#v", workspace)
229: 		}
230: 	}
231: 	for _, pane := range f.snapshot(t).Panes {
232: 		if pane.WorkspaceID == lead.Workspace.WorkspaceID && pane.PaneID == lead.RootPane.PaneID {
233: 			return
234: 		}
235: 	}
236: 	t.Fatal("Workspace Project teardown closed its Lead")
237: }

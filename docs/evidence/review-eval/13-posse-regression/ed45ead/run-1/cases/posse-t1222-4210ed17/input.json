723: func (p Plan) Encode() (string, error) {
724: 	if err := p.Validate(); err != nil {
725: 		return "", err
726: 	}
727: 	if p.legacyJSON != "" {
728: 		return p.legacyJSON, nil
729: 	}
730: 	data, err := json.Marshal(p)
731: 	return string(data), err
732: }
733: 
734: func (p Plan) ChangedFields(previous Plan) []string {
735: 	currentValue, previousValue := reflect.ValueOf(p), reflect.ValueOf(previous)
736: 	typeOfPlan := currentValue.Type()
737: 	var fields []string
738: 	for index := 0; index < currentValue.NumField(); index++ {
739: 		field := typeOfPlan.Field(index)
740: 		if !field.IsExported() || field.Name == "Revision" || field.Name == "PreviousSHA256" {
741: 			continue
742: 		}
743: 		if !reflect.DeepEqual(currentValue.Field(index).Interface(), previousValue.Field(index).Interface()) {
744: 			name, _, _ := strings.Cut(field.Tag.Get("json"), ",")
745: 			if name == "" {
746: 				name = field.Name
747: 			}
748: 			fields = append(fields, name)
749: 		}
750: 	}
751: 	return fields
752: }
753: 
754: func (p Plan) SHA256() string {
755: 	data, _ := json.Marshal(p)
756: 	if p.legacyJSON != "" {
757: 		data = []byte(p.legacyJSON)
758: 	}
759: 	sum := sha256.Sum256(data)
760: 	return hex.EncodeToString(sum[:])
761: }

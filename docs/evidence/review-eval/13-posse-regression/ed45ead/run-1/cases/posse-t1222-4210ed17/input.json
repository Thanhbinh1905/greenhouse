763: // Bind resolves only declared managed paths, never bytes selected from a source.
764: // It runs inside the Task creation transaction after choosing a sequence.
765: func (p Plan) Bind(taskID string) Plan {
766: 	if filepath.Base(p.Paths.Scratch) == "{task}" {
767: 		p.Paths.Scratch = filepath.Join(filepath.Dir(p.Paths.Scratch), taskID)
768: 	}
769: 	if filepath.Base(p.Paths.Output) == "{task}" {
770: 		p.Paths.Output = filepath.Join(filepath.Dir(p.Paths.Output), taskID)
771: 	}
772: 	return p
773: }

95: func TestReviewStartQueuesOneRefreshWhenCandidateTargetMoves(t *testing.T) {
96: 	f := reviewIdentityFixture(t)
97: 	changePath, _, changeSeq := startPrivateReviewChange(t, f, "3")
98: 	change := f.mustTask(t, changeSeq)
99: 	gitTest(t, f.env, f.repo, "commit", "--allow-empty", "-m", "advance frozen target")
100: 	gitTest(t, f.env, f.repo, "push", "origin", "HEAD:refs/heads/main")
101: 	candidate, err := f.db.LatestValidationCandidate(context.Background(), change.ID, "")
102: 	if err != nil {
103: 		t.Fatal(err)
104: 	}
105: 	workerEnv := setEnv(f.env, "HERDR_PANE_ID", change.PaneID)
106: 	workerEnv = setEnv(workerEnv, "POSSE_WORKER_HOME", f.home)
107: 	if code, output := runReleaseCLI(t, f.binary, candidate.WorktreePath, workerEnv, "signal", "working", "Rechecking stale candidate"); code != 0 {
108: 		t.Fatalf("reopen stale candidate task: %d %s", code, output)
109: 	}
110: 	turn, err := f.db.TaskTurnToken(context.Background(), change.ID)
111: 	if err != nil {
112: 		t.Fatal(err)
113: 	}
114: 	if code, output := runReleaseCLI(t, f.binary, candidate.WorktreePath, workerEnv, "signal", "done", "Stale candidate submitted for review", "--turn", turn); code != 0 {
115: 		t.Fatalf("signal stale candidate: %d %s", code, output)
116: 	}
117: 	var staleNoticeData string
118: 	if err := f.db.QueryRowContext(context.Background(), `SELECT data_json FROM notices WHERE task_id=? AND kind='task_done' ORDER BY id DESC LIMIT 1`, change.ID).Scan(&staleNoticeData); err != nil || strings.Contains(staleNoticeData, "next_action") {
119: 		t.Fatalf("stale candidate done Notice suggests another Review start: data=%s err=%v", staleNoticeData, err)
120: 	}
121: 
122: 	code, output := runReviewIdentityCLI(t, f, "review", "start", changeSeq, "--profile", "reviewer")
123: 	if code != 0 || !strings.Contains(output, "refresh") {
124: 		t.Fatalf("stale candidate Review start did not queue its target refresh: code=%d output=%s", code, output)
125: 	}
126: 	if code, output = runReviewIdentityCLI(t, f, "review", "start", changeSeq, "--profile", "reviewer"); code != 0 || !strings.Contains(output, "refresh_queued") {
127: 		t.Fatalf("repeated stale candidate Review start did not report the existing refresh: code=%d output=%s", code, output)
128: 	}
129: 	var instruction string
130: 	if err := f.db.QueryRowContext(context.Background(), `SELECT body FROM messages WHERE task_id=? ORDER BY id DESC LIMIT 1`, change.ID).Scan(&instruction); err != nil || !strings.Contains(instruction, "posse publish") {
131: 		t.Fatalf("refresh instruction=%q err=%v", instruction, err)
132: 	}
133: 	var rounds int
134: 	if err := f.db.QueryRowContext(context.Background(), `SELECT COUNT(*) FROM validation_fix_rounds WHERE ship_task_id=? AND kind='freshness'`, change.ID).Scan(&rounds); err != nil || rounds != 1 {
135: 		t.Fatalf("queued target refresh rounds=%d err=%v, want one", rounds, err)
136: 	}
137: 	workerEnv = setEnv(f.env, "HERDR_PANE_ID", change.PaneID)
138: 	workerEnv = setEnv(workerEnv, "POSSE_WORKER_HOME", f.home)
139: 	if code, output := runReleaseCLI(t, f.binary, changePath, workerEnv, "signal", "working", "Applying queued target refresh"); code != 0 {
140: 		t.Fatalf("reopen Change Task for refresh: %d %s", code, output)
141: 	}
142: 	gitTest(t, f.env, changePath, "fetch", "origin", "main")
143: 	gitTest(t, f.env, changePath, "merge", "--no-edit", "origin/main")
144: 	if code, output := runReleaseCLI(t, f.binary, changePath, workerEnv, "publish", "Refreshed candidate", "--verify", "go test ./... -> passed", "--proof", "Refresh intent verified", "--risk", "Risk: low\nRollback: revert"); code != 0 {
145: 		t.Fatalf("refresh candidate: %d %s", code, output)
146: 	}
147: 	candidate, err = f.db.LatestValidationCandidate(context.Background(), change.ID, "")
148: 	if err != nil {
149: 		t.Fatal(err)
150: 	}
151: 	if _, err := f.db.ExecContext(context.Background(), `UPDATE messages SET status='delivered',delivered_at=? WHERE task_id=? AND status='queued'`, time.Now().UnixMilli(), change.ID); err != nil {
152: 		t.Fatal(err)
153: 	}
154: 	turn, err = f.db.TaskTurnToken(context.Background(), change.ID)
155: 	if err != nil {
156: 		t.Fatal(err)
157: 	}
158: 	if code, output := runReleaseCLI(t, f.binary, candidate.WorktreePath, workerEnv, "signal", "done", "Candidate refreshed", "--turn", turn); code != 0 {
159: 		t.Fatalf("signal refreshed candidate: %d %s", code, output)
160: 	}
161: 	if code, output := runReviewIdentityCLI(t, f, "review", "start", changeSeq, "--profile", "reviewer"); code != 0 || !strings.Contains(output, "round") {
162: 		t.Fatalf("Review did not start after refreshed candidate Signal: code=%d output=%s", code, output)
163: 	}
164: }

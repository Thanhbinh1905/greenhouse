189: func planPreferences(plan *taskplan.Plan) []preferenceSource {
190: 	var sources []preferenceSource
191: 	for _, input := range plan.Inputs {
192: 		if input.Role == "preferences" {
193: 			sources = append(sources, preferenceSource{Layer: input.Layer, Path: input.Source, Content: string(input.Bytes), Exists: true, Legacy: input.Legacy})
194: 		}
195: 	}
196: 	return sources
197: }

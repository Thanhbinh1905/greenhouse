207: func TestTaskRoleSkillsRequireCodeCleanupOnlyWhenChangeTaskChanged(t *testing.T) {
208: 	root := t.TempDir()
209: 	gitTest(t, root, "init", "-b", "main")
210: 	gitTest(t, root, "config", "user.email", "test@example.com")
211: 	gitTest(t, root, "config", "user.name", "Test User")
212: 	if err := os.WriteFile(filepath.Join(root, "README.md"), []byte("base\n"), 0o600); err != nil {
213: 		t.Fatal(err)
214: 	}
215: 	gitTest(t, root, "add", "README.md")
216: 	gitTest(t, root, "commit", "-m", "base")
217: 	gitTest(t, root, "switch", "-c", "posse/task")
218: 	skills := []string{"posse-deslop", "posse-no-comments", "posse-technical-writing"}
219: 	for _, taskType := range []string{"review", "research"} {
220: 		got := taskRoleSkills(store.Task{Type: taskType}, skills)
221: 		if strings.Join(got, ",") != "posse-technical-writing" {
222: 			t.Errorf("%s Task skills = %v, want report skill only", taskType, got)
223: 		}
224: 	}
225: 	change := store.Task{Type: "change", WorktreePath: root, BaseRef: "main"}
226: 	if got := taskRoleSkills(change, skills); strings.Join(got, ",") != "posse-technical-writing" {
227: 		t.Fatalf("unchanged Change Task skills = %v, want report skill only", got)
228: 	}
229: 	if err := os.WriteFile(filepath.Join(root, "change.go"), []byte("package change\n"), 0o600); err != nil {
230: 		t.Fatal(err)
231: 	}
232: 	gitTest(t, root, "add", "change.go")
233: 	gitTest(t, root, "commit", "-m", "change")
234: 	if got := taskRoleSkills(change, skills); strings.Join(got, ",") != strings.Join(skills, ",") {
235: 		t.Fatalf("changed Change Task skills = %v, want %v", got, skills)
236: 	}
237: 	plan := &taskplan.Plan{Inputs: []taskplan.Input{{Role: "skill", Source: "posse-no-comments"}, {Role: "skill", Source: "posse-technical-writing"}}}
238: 	if got := roleSkillProtocol(plan, store.Task{Type: "review"}); strings.Contains(got, "posse-no-comments") || !strings.Contains(got, "posse-technical-writing") {
239: 		t.Fatalf("Review launch skill instructions = %q", got)
240: 	}
241: }
